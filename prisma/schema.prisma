generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum UserRole {
  SUPERADMIN
  ADMIN
  USER
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum SourceImage {
  EXTERNAL
  IMGBB
}

model QuranTrack {
  id            String @id @default(cuid())
  userId        String @unique
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentSurah  String
  currentAyat   String
  currentJuz    String
  currentStreak Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ShortPost {
  id String @id @default(cuid())

  imagesOnShortPosts ImagesOnShortPosts[]
  content            String?

  likes    Like[]
  comments Comment[]

  published              Boolean @default(false)
  showPrivateToFollowers Boolean @default(false)

  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  images    Image[]
}

model Image {
  id  String @id @default(cuid())
  url String

  title       String?
  description String?

  albums     Album[]
  shortPosts ImagesOnShortPosts[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  published              Boolean @default(false)
  showPrivateToFollowers Boolean @default(false)

  size   String?
  source SourceImage?

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  shortPost   ShortPost? @relation(fields: [shortPostId], references: [id])
  shortPostId String?

  @@index([userId])
}

model ImagesOnShortPosts {
  id          String    @id @default(cuid())
  image       Image     @relation(fields: [imageId], references: [id], onDelete: Cascade)
  imageId     String
  shortPost   ShortPost @relation(fields: [shortPostId], references: [id], onDelete: Cascade)
  shortPostId String

  createdAt DateTime @default(now())

  @@unique([imageId, shortPostId])
  @@index([imageId])
  @@index([shortPostId])
}

model Album {
  id            String  @id @default(cuid())
  name          String
  description   String?
  images        Image[]
  coverImageUrl String?

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  published              Boolean @default(false)
  showPrivateToFollowers Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
}

model Post {
  id                     String    @id @default(cuid())
  title                  String
  description            String
  image                  String?
  slug                   String    @unique
  excerpt                String?
  content                String    @db.Text
  published              Boolean   @default(false) // Public or private
  showPrivateToFollowers Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  author                 User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId               String
  tags                   Tag[]
  likes                  Like[]
  comments               Comment[]

  @@unique([id, slug])
  @@index([authorId])
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  posts Post[]
}

model TaskList {
  id          String  @id @default(cuid())
  userId      String
  title       String
  description String?
  active      Boolean @default(true)

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Task {
  id          String    @id @default(cuid())
  listId      String
  userId      String
  title       String
  description String?
  status      Status    @default(TODO)
  priority    Priority?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskList TaskList? @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([userId, listId])
}

model Chat {
  id          String    @id @default(cuid())
  title       String?
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  messages    Message[]
  model       String?
  recentModel String?

  isPublic Boolean @default(false) @map("is_public")
  shareId  String? @unique @map("share_id")

  @@index([userId, updatedAt])
  @@map("chats")
}

model Message {
  id        String      @id @default(cuid())
  messageId String
  chatId    String      @map("chat_id")
  chat      Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role      MessageRole
  content   String      @db.Text
  model     String?
  parts     Json?

  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
  @@map("messages")
}

model Follow {
  id String @id @default(cuid())

  follower   User   @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followerId String

  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Like {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  post        Post?      @relation(fields: [postId, post_slug], references: [id, slug], onDelete: Cascade)
  postId      String?
  post_slug   String?
  shortPost   ShortPost? @relation(fields: [shortPostId], references: [id], onDelete: Cascade)
  shortPostId String?

  @@unique([userId, postId]) // prevents same user liking post twice
  @@index([userId, postId, shortPostId]) // composite index for faster queries
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  post      Post?   @relation(fields: [postId, post_slug], references: [id, slug], onDelete: Cascade)
  postId    String?
  post_slug String?

  // for threading
  parentId    String?
  parent      Comment?   @relation("ReplyTo", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]  @relation("ReplyTo")
  shortPost   ShortPost? @relation(fields: [shortPostId], references: [id], onDelete: Cascade)
  shortPostId String?

  @@index([userId, postId, shortPostId])
}

model User {
  id              String      @id
  name            String
  email           String
  password        String?
  emailVerified   Boolean
  image           String?
  imageKey        String?
  defaultImage    String?
  biodata         String?
  showFollowStats Boolean     @default(true)
  role            UserRole    @default(USER)
  createdAt       DateTime
  updatedAt       DateTime
  sessions        Session[]
  accounts        Account[]
  posts           Post[]
  tasks           Task[]
  taskLists       TaskList[]
  quranTrack      QuranTrack?
  chats           Chat[]
  following       Follow[]    @relation("UserFollowing")
  followers       Follow[]    @relation("UserFollowers")
  likes           Like[]
  comments        Comment[]
  shortPosts      ShortPost[]
  images          Image[]
  albums          Album[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}
